rules_version = '2';

// Deny-by-default. The backend (Cloud Functions, Admin SDK) bypasses all rules;
// clients get only the narrow, explicitly-allowed paths below.
//
// Roles live in custom claims (`role`, `status`), set exclusively by the
// setUserAccess callable. The user doc mirrors them for UI display; the token is
// what these rules trust. A stale or tampered mirror must never grant anything.
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Signed in, and not through the password door for any address but the
     * one (Faisal, 2026-10-15: "should only accept that one email"). Every
     * other check is built on this, so a password session for another address
     * has no access at all. The literal is `PASSWORD_SIGN_IN_EMAIL` in shared,
     * restated because rules cannot import it; passwordDoor.test.ts holds the
     * two together. `beforeSignIn` refuses such a session before it exists;
     * this is the lock behind that door.
     */
    function isSignedIn() {
      return request.auth != null
        && (!isPasswordSession() || request.auth.token.get('email', '') == 'apps-reviewer@oursabeel.com');
    }
    // `.get` with defaults: a token without the `firebase` map must not make
    // every rule an error.
    function isPasswordSession() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password';
    }
    // Domain membership alone grants NOTHING — an admin must approve the account
    // (see docs/PRODUCT_BRIEF.md, "Domain restriction is a server-side check").
    function isActive() {
      return isSignedIn() && request.auth.token.get('status', '') == 'active';
    }
    /**
     * The SESSION's role. A password sign-in is a member whatever its claims
     * say (Faisal, 2026-10-15: "sign in thru email should never be able to be
     * an admin or manager. Just a member."), the same rule as `sessionAccess`
     * in shared and `actorOf` in functions.
     */
    function role() {
      return isPasswordSession() ? 'member' : request.auth.token.get('role', 'member');
    }
    /**
     * ORGANIZERS start boards. That is the whole of what the role grants.
     *
     * It was `manager`, and it meant three unrelated things at once — authority
     * over any board, sight of every board, and authority over org-wide config.
     * All three have moved: board authority is per-board (`ownsBoard` below),
     * and seeing everything, curating labels and reading Stats are `isAdmin`.
     * This helper survives at exactly ONE site, board create.
     */
    function canCreateBoards() {
      return isActive() && role() in ['organizer', 'admin'];
    }
    // Admins alone approve accounts, change roles, and see the whole org.
    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    /**
     * Who may ADMINISTER the board whose data is `b` — settings, columns,
     * membership, ownership, archiving, permanently deleting a card, moderating
     * a comment.
     *
     * MEMBERSHIP AND OWNERSHIP, never ownership alone. That pairing is what makes
     * a leftover owner entry inert, and it is why there is deliberately no rule
     * requiring `boardOwnerUids` to be a subset of `memberUids`.
     *
     * The invariant does hold in practice — `removeBoardMember` clears both lists
     * in one batch — but it holds because that code is right, and rules cannot
     * check an Admin SDK batch at all. A subset RULE would therefore convert any
     * lapse there, or any restore from a backup predating this shape, into a
     * board that silently stops accepting client edits and only an admin can
     * repair. The pairing makes the same lapse INERT instead: a stray entry
     * grants nothing, and `verify-board-owners.mjs` reports it.
     *
     * `.get('boardOwnerUids', [])`, never plain access. On a board that lacks the
     * field — an aborted backfill, a restore from before the migration — plain
     * access ERRORS, and an erroring rule denies. That would make exactly the
     * boards most in need of repair the ones nobody could repair. Same guard the
     * board's own `createdAt` and `activeCardCount` already carry, and `isAdmin()`
     * short-circuits first so an admin can always fix a board of any shape.
     */
    function ownsBoard(b) {
      return isAdmin()
        || (isActive()
            && request.auth.uid in b.memberUids
            && request.auth.uid in b.get('boardOwnerUids', []));
    }

    // ---- Users ----
    // Read-only to clients, and writes go through the setUserAccess callable.
    // Rationale: role and status are the entire security model. If clients could
    // write any field of their own user doc, every future field added here would
    // need re-auditing to be sure it is not privilege-adjacent. Denying writes
    // outright means that audit can never be forgotten.
    //
    // Later phases add narrow, field-scoped self-writes (notification
    // preferences, favourite boards) — never role or status.
    match /users/{userId} {
      // Fields a person may change about THEMSELVES. Everything here is a
      // display or notification preference — nothing privilege-adjacent. Adding
      // a field to this list is a security decision: ask whether a malicious
      // client setting it to anything at all could gain access or mislead an
      // admin. `role`, `status`, `email` and `displayName` are deliberately
      // absent (the first two are claims, the last two come from Google), as are
      // `claimsUpdatedAt` and `accessChangedBy`, which are the server's audit
      // trail, and `rulesVersion` and `rulesAcceptedAt`, which the acceptRules
      // callable alone writes: a client that could set them would mark itself as
      // having agreed to rules it was never shown.
      function selfWritableOnly() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['favoriteBoardIds', 'recentBoardIds', 'mutedBoardIds',
                    'notifyPrefs', 'unreadNotifCount']);
      }

      // Your own doc: needed even while pending, so the gate screen can show
      // your status and update live the moment an admin approves you.
      allow get: if isSignedIn() && request.auth.uid == userId;
      // Admins read every profile to run the approval queue. They need name and
      // email to judge a request, and they are the only ones who ever see the
      // full list.
      allow get, list: if isAdmin();

      // Preferences only, on your own doc, once you are approved.
      allow update: if isActive()
        && request.auth.uid == userId
        && selfWritableOnly();

      // Accounts are created by the auth trigger and never deleted by clients.
      allow create, delete: if false;
    }

    // ---- Notification inbox ----
    // Trigger-written. The client may ONLY mark an entry read — it cannot create
    // one, edit its text, or change who it came from. That is what makes the
    // inbox a trustworthy record rather than something any client could stuff.
    /**
     * Push tokens: one document per device, keyed by the token.
     *
     * Only ever your own, and only ever your own devices. A token is a
     * capability to notify a specific device, so letting anyone else write here
     * would let them point your notifications somewhere else — and letting
     * anyone READ the collection would expose which devices a person uses.
     *
     * `isSignedIn` rather than `isActive` deliberately: registration happens as
     * soon as you sign in, which is before an admin has approved you. Holding a
     * token grants nothing on its own — the send path checks status separately.
     *
     * Exactly two shapes (`PushTokenDoc` in shared). An Android phone or a
     * browser holds an FCM token; an iPhone holds Apple's and says which of
     * Apple's two services issued it, because the send path must ask that one
     * and the other refuses it (functions/src/apns.ts). `hasOnly`, because this
     * row is read by the send path, and a field nobody expects is a field
     * nobody validates. Writing over a row in the other shape is an ordinary
     * update: an iPhone that filed itself as 'android' before iPhones had rows
     * of their own replaces that row in place.
     */
    match /users/{userId}/pushTokens/{token} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && (
          (request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
            && request.resource.data.platform in ['android', 'web'])
          || (request.resource.data.keys().hasOnly(['platform', 'apnsEnvironment', 'updatedAt'])
            && request.resource.data.platform == 'ios'
            && request.resource.data.apnsEnvironment in ['development', 'production'])
        );
    }

    match /users/{userId}/notifications/{notifId} {
      allow get, list: if isActive() && request.auth.uid == userId;

      allow update: if isActive()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Clearing your own inbox is reasonable; writing to it is not.
      allow delete: if isActive() && request.auth.uid == userId;
      allow create: if false;
    }

    // ---- Boards ----
    // Two separate questions, and they were one until 2026-08-16.
    //
    // SEEING a board is membership: you are on it, or you are an admin. Nobody
    // else, no exceptions — an organizer has no more sight of a board they are
    // not on than a member does.
    //
    // ADMINISTERING one is `boardOwnerUids` — a per-board grant, orthogonal to
    // the org role, so a plain member can run a board without gaining anything
    // anywhere else. A member who is not an owner cannot edit the board they are
    // on, including removing themselves: that would look like leaving and would
    // strand their card assignments (see the removeBoardMember callable).
    match /boards/{boardId} {

      function existing() {
        return resource.data;
      }
      function incoming() {
        return request.resource.data;
      }
      function amMember(data) {
        return request.auth.uid in data.memberUids;
      }

      /**
       * The creator cannot be unseated by someone they delegated to.
       *
       * Phrased on the CHANGE, not the value. A value-shaped invariant — "the
       * creator must be in `boardOwnerUids`" — would brick every board an admin
       * had legitimately taken them off, because thereafter no write could
       * satisfy it. Testing the change means an already-demoted creator's board
       * simply stays editable by whoever is left.
       *
       * BOTH LISTS, not just the owner list. Authority is `member AND owner`, so
       * dropping the creator from `memberUids` unseats them just as completely as
       * dropping them from `boardOwnerUids` — and nothing makes the two move
       * together, because there is deliberately no subset rule (see `ownsBoard`).
       * An earlier version checked the owner list alone and claimed the pairing
       * forced coherence; it does not, and a write carrying
       * `memberUids: [me], boardOwnerUids: [me, creator]` walked straight through
       * it, leaving the creator off the board with an ownership entry that grants
       * nothing.
       *
       * Only an admin lifts it — including for the creator themselves, who
       * therefore cannot step down unaided. That was chosen deliberately: one
       * sentence with no exceptions to remember, at the price of an admin request
       * on the rare handover.
       */
      function keepsCreator() {
        return isAdmin()
          /**
           * Nothing left to protect, tested on BOTH halves for the same reason
           * the clause below checks both: authority is the pair, so a creator who
           * is an owner but no longer a member holds nothing already.
           *
           * Testing only the owner list here would BRICK that state. An owner can
           * write a departed creator's uid back into `boardOwnerUids` — inert, and
           * not reachable from the UI, but a legal write — and the board would
           * then demand of every subsequent write a membership no non-admin write
           * can restore. Precisely the unsatisfiable-invariant trap this whole
           * clause is phrased on the CHANGE to avoid.
           */
          || !(existing().createdBy in existing().get('boardOwnerUids', [])
               && existing().createdBy in existing().memberUids)
          || (existing().createdBy in incoming().get('boardOwnerUids', [])
              && existing().createdBy in incoming().memberUids);
      }

      /**
       * MEMBERSHIP DOES NOT CHANGE FROM A CLIENT, in either direction.
       *
       * Both halves are callables now: `addBoardMember` and `removeBoardMember`.
       * Adding became one because a non-admin owner cannot `list` the user
       * directory — rules allow that to admins alone — so the picker had nothing
       * to offer even though the write was permitted. Since the server does the
       * write, it also supplies the profile, which is the only way to stop an
       * owner writing an arbitrary name or address for a uid: `memberProfiles` is
       * a free-form map here and rules cannot cross-reference `users/`.
       *
       * Removal was already a callable, and for a sharper reason. "Assignees are
       * board members" is enforced on CARD writes only, so a board write that
       * dropped a member would leave their `assigneeUids` and `subscriberUids`
       * entries behind — and the card read rule has an arm for each, so the person
       * would keep read access to the very cards the removal was meant to take
       * away, while every one of those cards started failing its next edit. The
       * callable clears assignments, subscriptions, ownership and membership in
       * one batch so none of it can drift.
       *
       * NO ADMIN EXEMPTION any more. The old rule let membership grow from a
       * client and exempted admins from the shrink check, as a repair path. Both
       * callables gate on `canManageBoard`, which is true for an admin on any
       * board, so the capability is unchanged — only the direct client write is
       * gone. A board broken beyond that is a script's job, not a screen's.
       *
       * Board CREATE still sets `memberUids: [creator]`; this governs updates.
       */
      function membershipIsServerOnly() {
        return incoming().memberUids == existing().memberUids
          && incoming().get('memberProfiles', {}) == existing().get('memberProfiles', {});
      }

      // Admins see every board; everyone else sees only boards they are on. For
      // a LIST query, `isAdmin()` does not depend on document data, so an admin's
      // unconstrained query is provably safe; everyone else's must carry
      // `where('memberUids', 'array-contains', uid)` to satisfy the second arm.
      allow get, list: if isActive() && (isAdmin() || amMember(existing()));

      // Only organizers/admins create boards. The creator must be honest about
      // authorship and must include themselves, so a board can never be born
      // orphaned with no one able to see it.
      //
      // `boardOwnerUids == [creator]` is REQUIRED, not merely permitted, and that
      // is load-bearing rather than tidy. An app build too old to know about
      // ownership emits no such field, and the board it made would be
      // administrable by nobody but an admin — silently, permanently, and only
      // discovered by its author failing to rename it. Requiring the field turns
      // that into a refusal at creation, which reads as "your app is out of
      // date" and is the only acceptable failure mode here.
      allow create: if canCreateBoards()
        && incoming().keys().hasOnly(['name', 'description', 'archived', 'columns',
            'columnIds', 'memberUids', 'memberProfiles', 'boardOwnerUids',
            'activeCardCount', 'createdAt', 'createdBy'])
        && incoming().get('boardOwnerUids', []) == [request.auth.uid]
        && incoming().createdBy == request.auth.uid
        && incoming().archived == false
        && incoming().memberUids is list
        && request.auth.uid in incoming().memberUids
        // Shape-checked on create as well as update. The update rule already
        // required it, and a create rule laxer than its update rule leaves
        // exactly one document state the shape was never guaranteed for.
        && (!('memberProfiles' in incoming()) || incoming().memberProfiles is map)
        && incoming().columns is list
        && incoming().columnIds is list
        && incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 120;

      // Settings, columns, membership and OWNERSHIP are the board owner's work —
      // an admin, or a member the board's owners have promoted. Labels are NOT
      // here any more: they are org-wide documents (see match /labels).
      // A member who is not an owner deliberately cannot edit the board they are
      // on — including removing themselves, which would look like leaving but
      // would strand their card assignments (see the removeBoardMember callable).
      // Everything `create` validates, validated again here. An update rule that
      // is laxer than its create rule means the shape is only guaranteed for a
      // document's first write — which is not a guarantee at all, and is exactly
      // how the comment `mentionUids` check came to be enforced on new comments
      // and skippable by editing one.
      //
      // `.get(field, default)` rather than plain access on the pinned fields: a
      // board written before one of them existed would otherwise become
      // permanently uneditable, which is a far worse failure than the drift
      // being prevented.
      allow update: if ownsBoard(existing())
        && keepsCreator()
        && membershipIsServerOnly()
        && incoming().keys().hasOnly(['name', 'description', 'archived', 'columns',
            'columnIds', 'memberUids', 'memberProfiles', 'boardOwnerUids',
            'activeCardCount', 'createdAt', 'createdBy'])
        && incoming().get('boardOwnerUids', []) is list
        && incoming().createdBy == existing().createdBy
        // History, not state. Neither is the client's to rewrite.
        && incoming().get('createdAt', 0) == existing().get('createdAt', 0)
        // Trigger-owned (onCardBoardCount, Admin SDK, which bypasses these
        // rules). The client sets it to 0 at creation and must never touch it
        // again, or the Boards list can be made to disagree with the board.
        && incoming().get('activeCardCount', 0) == existing().get('activeCardCount', 0)
        && incoming().memberUids is list
        && incoming().columns is list
        && incoming().columnIds is list
        && (!('archived' in incoming()) || incoming().archived is bool)
        && (!('memberProfiles' in incoming()) || incoming().memberProfiles is map)
        && incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 120;

      // Boards archive, never hard-delete — far too much accumulated work to
      // expose a destroy button for. `archived` is a field, set via update.
      allow delete: if false;
    }

    // ---- Labels (org-wide) ----
    // One set of labels for the whole organisation: every board offers every
    // label, and a card's `labelIds` mean the same thing wherever the card is.
    //
    // A COLLECTION, not an array on a config document, and that is what makes
    // this block possible. Any active member may add a label, so concurrent
    // creates are the ordinary case — two people appending to one array field is
    // a lost write. And rules cannot iterate a list, so while labels lived on the
    // board the name cap was client-side only (see LABEL_NAME_MAX in
    // @sabeel/shared). One document per label makes it enforceable here.
    match /labels/{labelId} {
      function label() { return request.resource.data; }
      function existingLabel() { return resource.data; }

      // Everyone active reads them: a label can appear on a card on any board,
      // so restricting reads by board membership would blank out chips in My
      // Work and Search, which are cross-board by definition.
      allow read: if isActive();

      // ANY active member — deliberately wider than the gate on renaming below.
      // Adding a label is cheap, ordinary and reversible, and it happens while
      // someone is looking at a card rather than in board settings.
      //
      // Colour is checked for SHAPE, not against LABEL_COLORS. The palette is a
      // design constraint rather than a security boundary, and restating those
      // eight values here would be a second source of truth for them; the client
      // only ever offers swatches. A stray hex makes an ugly chip, not a breach.
      allow create: if isActive()
        && label().keys().hasOnly(['name', 'color', 'createdAt', 'createdBy'])
        && label().keys().hasAll(['name', 'color', 'createdAt', 'createdBy'])
        && label().name is string
        && label().name.size() > 0
        && label().name.size() <= 40
        && label().color is string
        && label().color.matches('^#[0-9A-Fa-f]{6}$')
        // Authorship is not the client's to invent. Nothing DISPLAYS it — it is
        // an audit field, the only record of where a stray label came from when
        // someone asks. (The 32 migrated from board arrays carry '', because
        // inventing an author for them would be a fabrication.)
        && label().createdBy == request.auth.uid
        && label().createdAt is number
        && label().createdAt <= request.time.toMillis() + 3600000;

      // ADMIN-only. Renaming and recolouring are curation: unlike creating, they
      // change what everyone else already sees — on every card on every board,
      // including boards the editor is not a member of. An org-wide effect takes
      // an org-wide authority, so owning a board grants no part of it. Nothing
      // else may move either: `createdAt`/`createdBy` are history.
      //
      // `.get(field, default)` on both sides rather than plain access, the same
      // old-document guard the board and card blocks carry: a label written
      // before one of these fields existed would otherwise be permanently
      // uneditable, which is a worse failure than the drift being prevented.
      allow update: if isAdmin()
        && label().keys().hasOnly(['name', 'color', 'createdAt', 'createdBy'])
        && label().name is string
        && label().name.size() > 0
        && label().name.size() <= 40
        && label().color is string
        && label().color.matches('^#[0-9A-Fa-f]{6}$')
        && label().get('createdAt', 0) == existingLabel().get('createdAt', 0)
        && label().get('createdBy', '') == existingLabel().get('createdBy', '');

      // Never from a client. Deleting a label must also strip its id from every
      // card that carries it, and a client cannot do that atomically across
      // boards it may not even be able to read — nor could a delete trigger name
      // who did it, which the activity log needs. The deleteLabel callable owns
      // this (the Admin SDK bypasses these rules). Same reasoning as attachments.
      allow delete: if false;
    }

    // ---- Cards (TOP-LEVEL collection) ----
    // Cards live at `cards/{cardId}` with a `boardId` field, not under the board.
    // That makes a cross-board MOVE a single `boardId` update — comments/activity
    // ride along under the card — instead of a delete+recreate, and it is what
    // lets any board MEMBER move a card, since a move is an edit, not a delete.
    //
    // `boardId` is client-supplied, so the whole model rests on these rules:
    // every read/write resolves the board FROM the field and checks membership.
    // `boardId` is mutable-but-constrained — a move may change it, but only to a
    // board the caller is a member of, with a column and assignees valid for THAT
    // board. `createdBy`/`createdAt` are history; `updatedBy` is pinned so the
    // recorded actor (activity log, move notifications) cannot be forged.
    match /cards/{cardId} {

      function boardById(id) {
        return get(/databases/$(database)/documents/boards/$(id)).data;
      }
      // Membership of a board. The ADMIN arm short-circuits without consulting
      // the document; it used to be the manager arm, which is what let every
      // manager read and write cards on boards they were not on.
      function memberOf(boardData) {
        return isAdmin() || request.auth.uid in boardData.memberUids;
      }
      function newCard() { return request.resource.data; }
      function oldCard() { return resource.data; }
      // The board a card is being written INTO: the destination on a move, or the
      // board on a plain create/edit.
      function destBoard() { return boardById(newCard().boardId); }

      // Assignees MUST be members of the card's board — load-bearing, not
      // tidiness. The read rule lets an assignee read a card without consulting
      // the board (the arm that powers "My Work"); if someone could be assigned
      // without being a member, that arm would hand out access to boards they are
      // not on. See docs/PRODUCT_BRIEF.md § Cross-board "My Work".
      function assigneesAreMembers() {
        return newCard().assigneeUids is list
          && newCard().assigneeUids.hasOnly(destBoard().memberUids);
      }
      /**
       * Subscribers are held to the SAME rule as assignees, and for a sharper
       * reason: the read rule below has a subscriber arm, so being subscribed
       * grants read. Without this, adding your own uid to any card you happened
       * to learn the id of would be a way into a board you are not on.
       *
       * `.get('subscriberUids', [])` rather than plain access — a card written
       * before the field existed carries no such key, and requiring it would
       * make every one of them permanently uneditable.
       */
      function subscribersAreMembers() {
        return newCard().get('subscriberUids', []) is list
          && newCard().get('subscriberUids', []).hasOnly(destBoard().memberUids);
      }
      // Clients cannot invent columns. `columnIds` is the board's flat id list.
      function columnExists() {
        return newCard().columnId in destBoard().columnIds;
      }

      /**
       * The fields on a card that only a TRIGGER may move.
       *
       * One definition rather than a line per field, which is what the third one
       * needed: `lastActivityAt` was added by copying `attachmentCount`'s pin,
       * and `commentCount` — in the key list since the beginning — turned out
       * never to have been pinned at all. Any active member could write it to
       * whatever they liked, `onCommentWritten` only ever INCREMENTS, so a
       * forged value never self-corrects, and unlike the stats counters there is
       * no backfill script that would rebuild it. The card screen renders
       * `Comments (N)` straight from the field.
       *
       * `.get(…, 0)` on both sides throughout: a card written before one of
       * these fields existed carries no such key, and requiring it would make
       * every one of them permanently uneditable. Rules do not apply to Admin
       * SDK writes, which is how the triggers move what nothing else can.
       */
      function triggerOwnedAreZero() {
        return newCard().get('commentCount', 0) == 0
          && newCard().get('attachmentCount', 0) == 0
          && newCard().get('lastActivityAt', 0) == 0;
      }
      function triggerOwnedUnchanged() {
        return newCard().get('commentCount', 0) == oldCard().get('commentCount', 0)
          && newCard().get('attachmentCount', 0) == oldCard().get('attachmentCount', 0)
          && newCard().get('lastActivityAt', 0) == oldCard().get('lastActivityAt', 0);
      }

      /**
       * A client-written millisecond stamp, bounded to "not in the future".
       *
       * Pinning `lastActivityAt` on its own secures NOTHING, because it is not
       * the only input to the order it was pinned to protect: Search sorts by
       * `lastActivityOf`, which is `max(lastActivityAt, updatedAt, createdAt)`,
       * and `updatedAt` is client-written with its value constrained nowhere. A
       * member could write `updatedAt: 9e15` on any card they may edit and pin it
       * to the top of "Newest first" — and the bottom of "Oldest first" — for
       * every colleague, permanently.
       *
       * Bounded rather than pinned, because an ordinary edit must move it. An
       * hour of forward slack for a client clock, the same allowance the label
       * rules already give.
       *
       * ONE-SIDED, and that is a decision rather than an omission. A floor would
       * close the mirror of this — a card CREATED claiming epoch zero sits at the
       * top of "Oldest first" — but the two are not the same size: the ceiling
       * holds the top of the DEFAULT order in front of every colleague, while the
       * floor holds the top of one they have to choose. Each bound is also
       * another way an ordinary action fails outright for a clock nobody in this
       * office controls, and `createdAt` is pinned across every update, so an
       * existing card cannot be walked backwards.
       */
      function notFutureStamp(ms) {
        return ms is number && ms <= request.time.toMillis() + 3600000;
      }
      /**
       * On an UPDATE the test is on the CHANGE, not on the value.
       *
       * A card stamped from a badly-set clock before this rule existed would
       * otherwise become permanently unwritable by the one path that does not
       * restamp it — `subscribeToCard` deliberately leaves `updatedAt` alone, so
       * following a conversation would start failing on a card nobody can fix.
       * Carrying the stored value through is always allowed; CHOOSING a new one
       * is what has to be in the past, which is the whole of the attack.
       */
      function stampNotMovedForward(field) {
        return newCard().get(field, 0) == oldCard().get(field, 0)
          || notFutureStamp(newCard().get(field, 0));
      }
      function wellFormed() {
        // No unknown keys: a card may hold ONLY these fields (the CardDoc type in
        // @sabeel/shared). Without this an approved member could bloat a card with
        // an arbitrary field, and every board viewer re-downloads it. `sourceId`
        // (ClickUp import) and `archivedAt` are legitimate optionals and MUST be
        // listed, or writes to those cards would break.
        return newCard().keys().hasOnly([
            'boardId', 'title', 'description', 'columnId', 'rank', 'assigneeUids',
            'subscriberUids',
            'dueDate', 'priority', 'labelIds', 'archived', 'archivedAt',
            'commentCount', 'attachmentCount', 'parentId', 'createdAt',
            'createdBy', 'updatedAt', 'updatedBy', 'lastActivityAt', 'sourceId',
          ])
          && newCard().boardId is string
          && newCard().title is string
          && newCard().title.size() > 0
          && newCard().title.size() <= 200
          && newCard().description is string
          // Bounded so one paste cannot inflate a card toward the 1MB doc limit.
          && newCard().description.size() <= 20000
          && newCard().rank is string
          && newCard().rank.size() > 0
          && newCard().archived is bool
          && newCard().labelIds is list
          && newCard().priority in ['none', 'low', 'medium', 'high', 'urgent']
          && (!('dueDate' in newCard()) || newCard().dueDate is string)
          && (!('sourceId' in newCard())
              || (newCard().sourceId is string && newCard().sourceId.size() <= 200))
          // The card this one is a subtask of. Shape only: checking that the
          // parent EXISTS and is on the same board would need a card -> card
          // get() — the first in this block — costing a read per write and
          // racing a concurrent delete. It is not a security boundary either:
          // this is an opaque string, and a child's read access comes from its
          // own boardId. Same-board is enforced by the picker, and a stale link
          // renders as nothing. See CardDoc.parentId.
          && (!('parentId' in newCard())
              || (newCard().parentId is string && newCard().parentId.size() <= 200))
          && columnExists()
          && assigneesAreMembers()
          && subscribersAreMembers();
      }

      // Assignee and subscriber arms FIRST so the two cross-board "My Work"
      // queries (`assigneeUids array-contains me`, `subscriberUids
      // array-contains me`) are authorized with ZERO board reads; the board-view
      // query falls through to the membership arm, whose board read is cached
      // across the whole list (all rows share one boardId). Admins match the
      // membership arm with no read (they see every board).
      //
      // Neither arm WIDENS access: both lists are constrained to board members
      // on every write, so anyone matching here could already read the card
      // through the membership arm. What they buy is a list query that needs no
      // per-row board lookup — a cross-board list has a different boardId on
      // every row, so the membership arm would mean one get() each.
      allow get, list: if (isActive() && request.auth.uid in resource.data.assigneeUids)
        || (isActive()
            && request.auth.uid in resource.data.get('subscriberUids', []))
        || (isActive() && memberOf(boardById(resource.data.boardId)));

      allow create: if isActive()
        && memberOf(destBoard())
        && wellFormed()
        && newCard().createdBy == request.auth.uid
        && newCard().updatedBy == request.auth.uid
        && newCard().archived == false
        // A card is born with no comments, no files and no activity. `.get(…, 0)`
        // so omitting a field is fine — what is refused is a client CLAIMING a
        // count, or claiming the activity clock that orders Search.
        && triggerOwnedAreZero()
        // Neither stamp may claim the future — see `notFutureStamp`, which
        // explains what "Newest first" is worth without this. `createdAt` is
        // pinned to the stored value on every update, so create is the ONE place
        // a client gets to choose it at all.
        && notFutureStamp(newCard().get('createdAt', 0))
        && notFutureStamp(newCard().get('updatedAt', 0));

      // Edit AND move. A move mutates `boardId`; require membership of BOTH the
      // board the card is on now and the destination, validating column and
      // assignees against the destination (wellFormed → destBoard). When boardId
      // is unchanged both reads resolve the same board → one cached read.
      allow update: if isActive()
        && memberOf(boardById(oldCard().boardId))
        && memberOf(destBoard())
        && wellFormed()
        && newCard().createdBy == oldCard().createdBy
        && newCard().createdAt == oldCard().createdAt
        && newCard().updatedBy == request.auth.uid
        // Trigger-owned, like activeCardCount on a board: the comment and
        // attachment paths move these, so a client edit carries all three
        // through unchanged.
        && triggerOwnedUnchanged()
        // And the other input to the order those pins protect.
        && stampNotMovedForward('updatedAt');

      // Members archive (an update setting archived=true); permanent deletion is
      // for this board's OWNERS and admins. A move is an update, so it is NOT
      // gated here. Costs a board read the org-role check did not — destroying a
      // card is rare, and the question cannot be answered without the board.
      allow delete: if ownsBoard(boardById(resource.data.boardId));
    }

    // ---- Comments ----
    // Anyone who can see the board can comment, including viewers-by-membership.
    // boardId is no longer in the path, so resolve it card → board (both gets are
    // cached across a comment-list query: same card, same board).
    match /cards/{cardId}/comments/{commentId} {

      function cardBoardId() {
        return get(/databases/$(database)/documents/cards/$(cardId)).data.boardId;
      }
      function board() {
        return get(/databases/$(database)/documents/boards/$(cardBoardId())).data;
      }
      function onBoard() {
        return isActive() && (isAdmin() || request.auth.uid in board().memberUids);
      }
      function comment() {
        return request.resource.data;
      }

      allow get, list: if onBoard();

      allow create: if onBoard()
        // Only the known CommentDoc fields — no arbitrary padding.
        && comment().keys().hasOnly(['authorUid', 'body', 'mentionUids', 'createdAt', 'editedAt'])
        // Authorship cannot be forged: you comment as yourself or not at all.
        && comment().authorUid == request.auth.uid
        && comment().body is string
        && comment().body.size() > 0
        && comment().body.size() <= 5000
        && comment().mentionUids is list
        // Mentions must be board members, or a mention would notify someone who
        // cannot open the card it points at.
        && comment().mentionUids.hasOnly(board().memberUids);

      // Only the author edits — an owner rewriting someone's words under their
      // name would be worse than useless.
      allow update: if onBoard()
        && comment().keys().hasOnly(['authorUid', 'body', 'mentionUids', 'createdAt', 'editedAt'])
        && resource.data.authorUid == request.auth.uid
        && comment().authorUid == resource.data.authorUid
        && comment().createdAt == resource.data.createdAt
        && comment().body is string
        && comment().body.size() > 0
        && comment().body.size() <= 5000
        // The SAME mention check as create. It was missing here while
        // `mentionUids` sat in the allowlist above, so the board-membership
        // invariant held for a new comment and could be walked straight past by
        // editing one — and an edit is when mentions change, now that editing
        // re-derives them. A rule that only guards the first write is not a
        // guard.
        && comment().mentionUids is list
        && comment().mentionUids.hasOnly(board().memberUids);

      // Authors delete their own; this board's owners and admins can remove
      // anything, which is the moderation path. Moderation is a property of the
      // board, not of a rank in the organisation.
      allow delete: if onBoard()
        && (resource.data.authorUid == request.auth.uid || ownsBoard(board()));
    }

    // ---- Attachments ----
    // Files on a card. THIS RULE IS THE UPLOAD'S AUTHORIZATION. Cloud Storage
    // rules cannot read Firestore, so `storage.rules` cannot ask whether someone
    // is on this card's board — only a Firestore rule can, and the object is
    // then written to a path derived from ids that only a successful create here
    // could have produced.
    //
    // Nothing ever reads the bytes through Storage: `storage.rules` denies reads
    // outright and downloads go through the getAttachmentUrl callable, which
    // repeats this membership check before signing. boardId is resolved
    // card → board, same as comments.
    match /cards/{cardId}/attachments/{attachmentId} {

      function cardBoardId() {
        return get(/databases/$(database)/documents/cards/$(cardId)).data.boardId;
      }
      function board() {
        return get(/databases/$(database)/documents/boards/$(cardBoardId())).data;
      }
      function onBoard() {
        return isActive() && (isAdmin() || request.auth.uid in board().memberUids);
      }
      function attachment() {
        return request.resource.data;
      }

      allow get, list: if onBoard();

      // `sizeBytes` is deliberately ABSENT from the allowlist: it is read off the
      // object by finalizeAttachment and never claimed by the uploader, so a
      // client cannot write it at all.
      allow create: if onBoard()
        && attachment().keys().hasOnly(['name', 'contentType', 'uploadedBy', 'uploadedAt', 'status'])
        // You attach as yourself or not at all.
        && attachment().uploadedBy == request.auth.uid
        // Every attachment starts unfinished; only the server moves it on.
        && attachment().status == 'uploading'
        && attachment().name is string
        && attachment().name.size() > 0
        && attachment().name.size() <= 255
        && attachment().contentType is string
        && attachment().contentType.size() > 0
        && attachment().contentType.size() <= 255
        && attachment().uploadedAt is number
        // Bounded against the SERVER's clock, which no other client timestamp
        // in these rules is — because this one is load-bearing. The nightly
        // pruneAttachments decides what to clean up by age, so a document
        // claiming to be from the year 3000 is never swept and its bytes are
        // billed forever. Only the upper side is bounded: a too-OLD value just
        // means the document is swept sooner, which a retry fixes, whereas
        // rejecting it would break attaching for anyone whose device clock is
        // behind.
        //
        // An HOUR of slack, not minutes: the sweep's cutoff is 24 hours, so
        // anything inside that window is still swept eventually and the attack
        // needs a far-future value. A tight bound would instead refuse a real
        // person whose clock is merely wrong — trading a rare cost leak for a
        // broken feature.
        && attachment().uploadedAt <= request.time.toMillis() + 3600000;

      // Clients neither edit nor delete an attachment.
      //
      // UPDATE belongs to finalizeAttachment alone (the Admin SDK bypasses these
      // rules), so `ready` cannot be forged onto a document whose bytes never
      // arrived, and the recorded size is always the one the server read.
      //
      // DELETE goes through the deleteAttachment callable, for two reasons.
      // `storage.rules` denies clients deleting objects, so a client-side
      // deleteDoc would remove the record and strand the bytes — unreferenced,
      // unreadable, invisible and billable. And a Firestore delete trigger
      // cannot know WHO deleted, which the activity log needs: removal is
      // recorded, and a record naming nobody is not a record.
      //
      // Who may remove one is therefore enforced in the callable: any active
      // member of the board, deliberately NOT the owner-only gate that
      // permanent card deletion uses. Attaching the wrong file is an ordinary
      // mistake and should not need someone else to undo.
      allow update, delete: if false;
    }

    // ---- Activity ----
    // Read-only to every client, always. The log is trustworthy precisely
    // because nobody can write it: "Sara moved this to Done" means the server
    // saw Sara move it. Written by the onCardWritten trigger and by the
    // attachment callables, both server-side. boardId is resolved card → board,
    // same as comments.
    match /cards/{cardId}/activity/{activityId} {
      function cardBoardId() {
        return get(/databases/$(database)/documents/cards/$(cardId)).data.boardId;
      }
      function board() {
        return get(/databases/$(database)/documents/boards/$(cardBoardId())).data;
      }
      allow get, list: if isActive()
        && (isAdmin() || request.auth.uid in board().memberUids);
      allow create, update, delete: if false;
    }

    // Note: there is no collection-group `cards` rule any more. Cards are a
    // top-level collection, so "My Work" (`collection('cards') where assigneeUids
    // array-contains me`) is authorized by the assignee arm of the card read rule
    // above — no parent lookup, exactly as before, but now a plain query.

    // ---- Stats ----
    // Usage counters, server-written only — same trust model as activity and
    // notifications. A client that could write these could lie about them, and
    // rules have no way to check a count against reality.
    //
    // ADMINS only. It used to be managers, which was safe only because a manager
    // could already open every board — once that stopped being true, this rule
    // became a way to read any board's activity by id without being on it, and
    // without the UI ever showing it. `isAdmin()` already implies `isActive()`.
    //
    // `{scope}` is a boardId or the org-wide `_all` roll-up. Both are covered by
    // the same rule on purpose: an org-wide total is strictly less revealing
    // than the per-board numbers it is made of.
    match /stats/{scope} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;

      match /months/{month} {
        allow get, list: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ---- Reports (Report a problem) ----
    // Written by the reportProblem callable alone and read by nobody in the
    // app: a report is emailed to the institute's administrators, and this is
    // the record that it was made. A client that could read it would see who
    // reported whom; one that could write it could file reports in someone
    // else's name, or past the hourly limit the callable counts from here.
    // Stated rather than left to the catch-all, so the denial is a decision on
    // the page and not an absence.
    match /reports/{reportId} {
      allow read, write: if false;
    }

    // ---- Everything else ----
    // Comments, activity and notifications arrive with their phases. This
    // catch-all keeps the deny-by-default posture testable, and makes a future
    // `match` added at the wrong nesting level fail loudly rather than silently
    // inheriting an allow.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
