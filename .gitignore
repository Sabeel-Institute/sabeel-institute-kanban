node_modules/
dist/
dist-web*/
# Compiled TypeScript output. ANCHORED, not a bare `lib/`: an unanchored pattern
# matches a directory named lib at ANY depth, which silently swallowed
# scripts/lib/ — source that the test suite imports. A file that is ignored but
# present looks exactly like a committed one on the machine that wrote it.
functions/lib/
packages/shared/lib/
build/
coverage/
.expo/
*.log
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# Secrets & local config — never commit
.env
.env.local
app/.env.local
functions/.env
# Sentry build config. The properties files should never exist here — the org
# and projects are ci-tools.json's, the token is app/.env.sentry-build-plugin's
# (docs/SECRETS.md) — but the tooling writes a real auth token into them, and
# this repo is PUBLIC. Backstop, not a plan.
app/android/sentry.properties
app/ios/sentry.properties
.env.sentry-build-plugin
app/.env.sentry-build-plugin

# Migration inputs (ClickUp exports may contain personal data)
migration/
docs/brand/*.tmp

# What scripts/dev.sh started, by process group: what its `stop` stops.
.dev-pids

# Screenshots and logs of the browser and device suites
shots/

# Android build output (android/ itself IS committed once generated)
app/android/.gradle/
app/android/app/build/
app/android/build/
*.keystore
!app/android/app/debug.keystore

.DS_Store
functions/.secret.local

# Kotlin compiler session files from Gradle builds
app/android/.kotlin/
# Generated at every build by `sabeel-ci build-info` (version + git hash).
app/src/build-info.ts

# Python bytecode from scripts/
__pycache__/

# Generated by `expo prebuild --platform ios`; not hand-edited, not committed.
app/ios/

# Release signing — the keystore and its passwords never enter this repo; they
# live in ~/.config/sabeel-kanban/ (docs/SECRETS.md).
app/android/keystore.properties
*.jks
# Play publishing and Firebase Admin credentials. They belong in ~/keys/, never
# here — this repo is PUBLIC, and a service-account key committed once stays
# readable in history.
*play-publisher*.json
*service-account*.json
*firebase-adminsdk*.json

# Metro transform cache, kept in-repo (see app/metro.config.js)
app/.metro-cache/
gha-creds-*.json
