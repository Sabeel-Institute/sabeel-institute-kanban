{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    },
    "app": {
      "entry": [
        "App.tsx",
        "metro.config.js",
        "public/**/*.js",
        "src/**/*.web.ts",
        "src/**/*.web.tsx"
      ],
      "project": [
        "**/*.{ts,tsx,js}"
      ],
      "ignoreDependencies": [
        "expo-updates",
        "@expo/metro-runtime",
        "expo-system-ui"
      ]
    },
    "functions": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@google-cloud/functions-framework"
      ]
    },
    "packages/shared": {
      "entry": [],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "firebase",
    "expo"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
