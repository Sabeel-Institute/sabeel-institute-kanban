{
  "name": "sabeel-institute-kanban",
  "version": "0.0.0",
  "private": true,
  "description": "Sabeel Institute Kanban — access-controlled kanban boards for a small nonprofit (Android + web from one Expo codebase, Firebase backend)",
  "workspaces": [
    "packages/*",
    "functions",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build -w @sabeel/shared && sabeel-ci build-info",
    "lint": "eslint . && npm run check:version && npm run check:text",
    "pretypecheck": "npm run build -w @sabeel/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @sabeel/shared",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "sabeel-ci test-emulator",
    "test:screens": "bash scripts/e2e.sh scripts/screens-e2e.mjs",
    "test:e2e": "bash scripts/e2e.sh scripts/web-e2e.mjs",
    "test:e2e:attachments": "bash scripts/e2e.sh scripts/attachments-e2e.mjs",
    "test:e2e:stats": "bash scripts/e2e.sh scripts/stats-e2e.mjs",
    "test:e2e:richtext": "bash scripts/e2e.sh scripts/richtext-e2e.mjs",
    "test:e2e:typing-perf": "bash scripts/e2e.sh scripts/typing-perf-e2e.mjs",
    "build": "npm run build -w @sabeel/shared && npm run build -w functions",
    "knip": "knip",
    "check:version": "sabeel-ci check-version",
    "check:text": "sabeel-ci check-text-sources",
    "emulators": "sabeel-ci emulators",
    "emulators:free": "sabeel-ci free-emulator-ports",
    "dev:web": "npm run build -w @sabeel/shared && sabeel-ci build-info && WEB_PORT=$(sabeel-ci ports web) && cd app && EXPO_PUBLIC_USE_EMULATORS=1 npx expo start --web --port \"$WEB_PORT\"",
    "dev:android": "npm run build -w @sabeel/shared && sabeel-ci build-info && sabeel-ci preflight-metro && cd app && EXPO_PUBLIC_USE_EMULATORS=1 npx expo run:android --app-id com.sabeelinstitute.kanban.debug",
    "dev:ios": "bash scripts/dev.sh ios",
    "build:aab": "sabeel-ci build-aab",
    "check:ios": "sabeel-ci check-ios-config",
    "build:ios": "sabeel-ci build-ios",
    "check:push": "sabeel-ci check-push",
    "check:web-push": "sabeel-ci check-web-push",
    "grant-admin": "bash scripts/grant-admin.sh",
    "seed": "node scripts/seed-emulators.mjs",
    "probe-indexes": "GCLOUD_PROJECT=sabeel-institute-kanban node scripts/probe-indexes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@sabeel-institute/ci-tools": "github:Sabeel-Institute/ci-tools#ee85355ca4f6a373087d7ed538abd0a65ae1ef85",
    "@sabeel/shared": "*",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^13.10.0",
    "globals": "^16.5.0",
    "knip": "^5.88.1",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
