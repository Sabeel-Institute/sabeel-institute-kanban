{
  "name": "sabeel-institute-kanban",
  "version": "0.0.0",
  "private": true,
  "description": "Sabeel Institute Kanban — access-controlled kanban boards for a small nonprofit (Android + web from one Expo codebase, Firebase backend)",
  "workspaces": [
    "packages/*",
    "functions",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build -w @sabeel/shared && node scripts/gen-build-info.mjs",
    "lint": "eslint .",
    "pretypecheck": "npm run build -w @sabeel/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build -w @sabeel/shared",
    "test": "npm run test --workspaces --if-present",
    "test:emulator": "bash scripts/test-emulator.sh",
    "e2e": "bash scripts/e2e.sh",
    "build": "npm run build -w @sabeel/shared && npm run build -w functions",
    "emulators": "bash scripts/emulators.sh",
    "dev:web": "npm run build -w @sabeel/shared && node scripts/gen-build-info.mjs && cd app && EXPO_PUBLIC_USE_EMULATORS=1 npx expo start --web --port 61210",
    "dev:android": "npm run build -w @sabeel/shared && node scripts/gen-build-info.mjs && node scripts/preflight-metro.mjs && cd app && EXPO_PUBLIC_USE_EMULATORS=1 npx expo run:android --app-id com.sabeelinstitute.kanban.debug",
    "dev:ios": "bash scripts/dev.sh ios",
    "build:apk": "node scripts/gen-build-info.mjs && cd app/android && ./gradlew assembleRelease --no-daemon",
    "build:aab": "bash scripts/build-aab.sh",
    "check:ios": "node scripts/check-ios-config.mjs",
    "grant-admin": "bash scripts/grant-admin.sh",
    "seed": "node scripts/seed-dev.mjs",
    "probe-indexes": "GCLOUD_PROJECT=sabeel-institute-kanban node scripts/probe-indexes.mjs",
    "deadcode": "knip",
    "publish:play": "node scripts/publish-play.mjs",
    "build:ios": "bash scripts/build-ios.sh",
    "check:web-push": "node scripts/check-web-push.mjs",
    "check:apple-push": "node scripts/check-apple-push.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-admin": "^13.10.0",
    "globals": "^16.5.0",
    "google-auth-library": "^11.3.1",
    "knip": "^5.88.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
