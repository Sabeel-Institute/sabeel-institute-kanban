<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- What THIS file declares: INTERNET (Firebase) and VIBRATE (notification
       buzz). No overlay permissions — there is no draw-over-apps feature. Those
       were Expo scaffold defaults; a future `expo prebuild` would re-add them,
       so they must be suppressed in app.json if this native project is ever
       regenerated (android/ is committed, not regenerated now).

       This is NOT the whole permission list, and reading it as one is a mistake
       worth naming: libraries merge their own in. Since attachments landed, the
       MERGED manifest also carries CAMERA (expo-image-picker, for "Take a
       photo"). Check the merged output under
       android/app/build/intermediates/merged_manifest/, never this file alone. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>

  <!-- Both external-storage permissions are removed, on every Android version.

       expo-file-system and expo-image-picker each declare them capped at API 32,
       for their camera-roll APIs, which this app never calls. "Photo library"
       is launchImageLibraryAsync: androidx's PickVisualMedia, the system photo
       picker, which falls back to the system document picker where a phone
       has no photo picker, and grants the app the one picked item. "Files" is
       the document picker. Neither checks or needs a storage permission on
       any version, and the app reads only its own cache. So the entries are
       dead weight everywhere, and a permission nobody needs is one that makes
       people refuse an install. Only "Take a photo" asks for anything: CAMERA,
       at the moment of the tap (filePicker.ts). -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
    <!-- Opening an attachment in whatever app claims its type.
         On API 30+ package visibility hides every handler unless it is declared
         here, and the failure is silent: startActivityAsync resolves to nothing
         and the tap simply does nothing at all. expo-intent-launcher ships an
         empty manifest, so this cannot come from the library. -->
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <data android:mimeType="*/*"/>
    </intent>
  </queries>
  <!-- allowBackup off: Android would otherwise copy the app's data, the stored
       sign-in included, to the person's Google Drive and put it back on a new
       or reset phone. -->
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <!-- The small icon and tint of a push, once per component that draws one.
         Two do, and each reads only its own keys. A push that arrives with the
         app in the background or closed is drawn by the FCM SDK from the first
         pair. One that arrives with the app OPEN reaches onMessageReceived
         instead and is drawn by expo-notifications — notify.ts's handler says
         to show it — from the second pair, and without that pair it falls back
         to the launcher icon: its full-bleed silhouette, untinted. With only the
         first pair set, this app showed two different small icons minutes apart
         (2026-09-16), and no device pass had caught it because a test push is
         sent to a closed app, which is the configured path. Both pairs name
         the same resources, and functions/test/unit/notificationIcon.test.ts
         holds them together. Set in the manifest rather than through the
         expo-notifications config plugin, which does nothing in this bare
         workflow because android/ is committed and prebuild never runs. -->
    <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notification"/>
    <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/ic_notification"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <!-- The channel a push lands in when its send names none. The functions
         always name PUSH_CHANNEL_ID (functions/src/fcm.ts), so this is not
         consulted today; it is here so that a send which ever stops naming it
         lands in the app's own channel rather than one Android makes up and
         shows as "Miscellaneous". A manifest cannot import the constant, so
         `npx sabeel-ci check-app` holds this literal to it. -->
    <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="sabeel-alerts"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="sabeelkanban"/>
      </intent-filter>
    </activity>
  </application>
</manifest>