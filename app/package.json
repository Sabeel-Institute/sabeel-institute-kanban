{
  "name": "@sabeel/app",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node ../scripts/preflight-metro.mjs && expo start",
    "android": "node ../scripts/preflight-metro.mjs && expo run:android",
    "web": "expo start --web",
    "web:export": "node ../scripts/check-version.mjs && node ../scripts/check-web-template.mjs && node ../scripts/gen-build-info.mjs && expo export --platform web --output-dir dist-web --clear",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sabeel/shared": "*",
    "@sentry/react": "^10.66.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.4",
    "expo-application": "~57.0.2",
    "expo-build-properties": "^57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-intent-launcher": "~57.0.1",
    "expo-notifications": "^57.0.6",
    "expo-sharing": "~57.0.7",
    "expo-status-bar": "~57.0.0",
    "firebase": "^12.15.0",
    "lexical": "^0.52.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-enriched-html": "^1.1.1",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
