# Function parameters for the emulator's demo project.

# Apple's push service is not reached under the emulator: messaging.ts
# suppresses every send there, and apns.test.ts stands a local server in.
# The values only have to exist, or the functions emulator refuses to load.
APNS_KEY_ID=EMULATOR00
APPLE_TEAM_ID=EMULATOR00

# Report a problem sends no email under the emulator (reports.ts records
# mail.status 'skipped'), so this account is never used; the value only has to
# exist.
REPORT_MAILER_SERVICE_ACCOUNT=report-mailer@demo-sabeel-kanban.iam.gserviceaccount.com
