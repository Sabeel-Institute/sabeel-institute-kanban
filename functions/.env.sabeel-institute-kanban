# Function parameters for the sabeel-institute-kanban project. Not secrets:
# those live in Secret Manager (docs/SECRETS.md).

# Apple's push service, for iPhones (functions/src/apns.ts). The key itself is
# the secret APNS_KEY; these two are not secret: the team id is in every signed
# app, and the key id is useless without the key.
APNS_KEY_ID=X5R8FL94BC
APPLE_TEAM_ID=XRKWA4QRN9

# Report a problem (functions/src/reports.ts) sends as apps-noreply@oursabeel.com
# by signing a delegation token as this service account. Not a secret: there is
# no key; the function's runtime account holds roles/iam.serviceAccountTokenCreator
# on it (docs/DEPLOY.md).
REPORT_MAILER_SERVICE_ACCOUNT=report-mailer@sabeel-institute-kanban.iam.gserviceaccount.com
